def calculate_sensitivity(background_gray, current_gray):
    """Calculate motion sensitivity percentage with pattern/vibration resistance and stability"""
    if background_gray is None or current_gray is None:
        return 0.0
   
    # 1. Apply strong Gaussian blur to reduce high-frequency patterns
    kernel = (MOTION_BLUR_KERNEL_SIZE, MOTION_BLUR_KERNEL_SIZE)
    blurred_bg = cv2.GaussianBlur(background_gray, kernel, 0)
    blurred_cur = cv2.GaussianBlur(current_gray, kernel, 0)
   
    # 2. Calculate difference with noise reduction
    diff = cv2.absdiff(blurred_bg, blurred_cur)
   
    # 3. Apply fixed threshold to ignore minor changes
    _, thresh = cv2.threshold(diff, MOTION_THRESHOLD, 255, cv2.THRESH_BINARY)
   
    # 4. Count motion pixels
    motion_pixels = cv2.countNonZero(thresh)
    total_pixels = thresh.size
    sensitivity = (motion_pixels / total_pixels) * 100 if total_pixels else 0.0
    
    # 5. Apply smoothing to prevent rapid changes
    if hasattr(state, 'last_sensitivity_readings'):
        state.last_sensitivity_readings.append(sensitivity)
        if len(state.last_sensitivity_readings) > 5:
            state.last_sensitivity_readings.pop(0)
        # Use median of last 5 readings for stability
        sensitivity = sorted(state.last_sensitivity_readings)[len(state.last_sensitivity_readings)//2]
    else:
        state.last_sensitivity_readings = [sensitivity]
    
    return sensitivity

def check_material_match(text, materials=None):
    """Check if text contains any material"""
    if materials is None:
        materials = state.materials
   
    if not text:
        return None, 0
   
    text_lower = text.lower().strip()
    for material in materials:
        if material.lower() in text_lower:
            return material, 100
    return None, 0

def rotate_image(img, angle):
    """Rotate image by specified angle"""
    if angle == 0:
        return img
    elif angle == 90:
        return cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)
    elif angle == 180:
        return cv2.rotate(img, cv2.ROTATE_180)
    elif angle == 270:
        return cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)
    else:
        (h, w) = img.shape[:2]
        center = (w // 2, h // 2)
        M = cv2.getRotationMatrix2D(center, angle, 1.0)
        return cv2.warpAffine(img, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

def create_save_task(text, roi_img, match_time, angle=0):
    """Create image save task with rotation and text overlay"""
    # Rotate the image to the matched angle
    rotated_img = rotate_image(roi_img, angle)
   
    # Overlay matched text in top-right
    font = cv2.FONT_HERSHEY_SIMPLEX
    font_scale = 1.2
    thickness = 3
    text_size = cv2.getTextSize(text, font, font_scale, thickness)[0]
    x = rotated_img.shape[1] - text_size[0] - 20  # Right-aligned
    y = 40  # Top margin
   
    # Add text with black border for readability
    cv2.putText(rotated_img, text, (x, y), font, font_scale, (0, 0, 0), thickness+2, cv2.LINE_AA)
    cv2.putText(rotated_img, text, (x, y), font, font_scale, (0, 255, 0), thickness, cv2.LINE_AA)
   
    # Generate filename
    safe_text = "".join(c for c in text if c.isalnum() or c in (' ', '_', '-')).rstrip()
    timestamp = match_time.strftime("%Y-%m-%d_%H-%M-%S")
    filename = f"{safe_text}_{timestamp}.png"
    filepath = os.path.join(MATCHED_IMAGE_DIR, filename)
   
    return (rotated_img, filepath, filename, text, match_time)

