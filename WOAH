def exe_dir_path(filename):
    if getattr(sys, 'frozen', False):
        folder = os.path.dirname(sys.executable)
    else:
        folder = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(folder, filename)

def load_config():
    """Load configuration from materials.txt"""
    global MOTION_THRESHOLD  # Make it accessible for modification
    config_file = exe_dir_path("materials.txt")
   
    # Default configuration values
    defaults = {
        "ROI": "",
        "RTSP_URL": "rtsp://root:123456789@192.168.0.90/axis-media/media.amp",
        "MATERIALS": ["pepsi", "coke", "sprite", "fanta"],
        "MOTION_THRESHOLD": 12
    }
   
    # Create default config if file doesn't exist
    if not os.path.exists(config_file):
        default_config = [
            f"ROI:{defaults['ROI']}",
            f"RTSP_URL:{defaults['RTSP_URL']}",
            f"MOTION_THRESHOLD:{defaults['MOTION_THRESHOLD']}  # 0=super sensitive, 255=blind",
            *defaults['MATERIALS']
        ]
        try:
            with open(config_file, 'w', encoding='utf-8') as f:
                f.write('\n'.join(default_config))
            print(f"[INFO] Created default materials.txt")
        except Exception as e:
            print(f"[ERROR] Failed to create default config: {e}")
   
    # Initialize state with defaults
    state.rtsp_url = defaults["RTSP_URL"]
    state.materials = []  # Start with empty materials list
    MOTION_THRESHOLD = defaults["MOTION_THRESHOLD"]  # Initialize with default
   
    try:
        if os.path.exists(config_file):
            with open(config_file, 'r', encoding='utf-8') as f:
                lines = [line.strip() for line in f if line.strip()]
           
            for line in lines:
                if ':' in line:
                    key, value = line.split(':', 1)
                    key, value = key.strip(), value.strip()
                    
                    # Remove comments from value
                    if '#' in value:
                        value = value.split('#')[0].strip()
                    
                    if key == 'ROI' and value:
                        try:
                            coords = list(map(int, value.split(',')))
                            if len(coords) == 4:
                                state.roi_box = (coords[0], coords[1], coords[2], coords[3])
                        except ValueError:
                            pass
                    elif key == 'RTSP_URL' and value:
                        state.rtsp_url = value
                    elif key == 'MOTION_THRESHOLD' and value:
                        try:
                            MOTION_THRESHOLD = int(value)
                            if MOTION_THRESHOLD < 0:
                                MOTION_THRESHOLD = 0
                            elif MOTION_THRESHOLD > 255:
                                MOTION_THRESHOLD = 255
                        except ValueError:
                            print(f"[WARN] Invalid MOTION_THRESHOLD value: {value}, using default")
                else:
                    if line and not any(line.startswith(k) for k in ['ROI:', 'RTSP_URL:', 'MOTION_THRESHOLD:']):
                        if line not in state.materials:
                            state.materials.append(line)
       
        print(f"[INFO] Loaded config: ROI={state.roi_box}, Materials={len(state.materials)}")
        print(f"[INFO] RTSP URL: {state.rtsp_url}")
        print(f"[INFO] Materials: {state.materials}")
        print(f"[INFO] Motion Threshold: {MOTION_THRESHOLD} (0=super sensitive, 255=blind)")
    except Exception as e:
        print(f"[ERROR] Failed to load config: {e}")

def measure_camera_fps_from_timestamps():
    """Measure actual camera FPS from frame capture timestamps over 5 seconds"""
    # Wait and collect timestamps for 5 seconds
    start_time = time.time()
    
    # Wait for 5 seconds of capture data
    while time.time() - start_time < 5.0:
        time.sleep(0.1)
    
    # Get timestamps from the last 5 seconds with thread safety
    with lock:
        current_time = time.time()
        recent_timestamps = [t for t in state.frame_timestamps if current_time - t <= 5.0]
    
    if len(recent_timestamps) < 10:
        print(f"[WARN] Insufficient frame data to measure FPS ({len(recent_timestamps)} frames in 5s)")
        return None
    
    # Calculate FPS from number of frames in time period
    time_span = max(recent_timestamps) - min(recent_timestamps)
    if time_span < 4.0:  # Need reasonable time span
        print(f"[WARN] Time span too small for accurate measurement ({time_span:.1f}s)")
        return None
    
    frame_count = len(recent_timestamps)
    detected_fps = frame_count / time_span
    
    return detected_fps

def detect_camera_fps(cap):
    """Detect actual camera FPS by measuring frame intervals (initial setup only)"""
    print("[INFO] Detecting initial camera FPS...")
    frame_times = []
    start_time = time.time()
    
    # Measure frame intervals for 3 seconds during initial setup
    while len(frame_times) < 50 and time.time() - start_time < 3:
        ret, _ = cap.read()
        if ret:
            frame_times.append(time.time())
        time.sleep(0.01)
    
    if len(frame_times) < 10:
        print(f"[WARN] Could not detect FPS, using default {CAMERA_FPS}")
        return CAMERA_FPS
    
    # Calculate average FPS from intervals
    intervals = [frame_times[i] - frame_times[i-1] for i in range(1, len(frame_times))]
    avg_interval = sum(intervals) / len(intervals)
    detected_fps = 1.0 / avg_interval
    
    print(f"[INFO] Initial camera FPS: {detected_fps:.1f}")
    return detected_fps

def connect_camera():
    """Connect to camera with retry logic and FPS detection"""
    for attempt in range(1, CAMERA_RECONNECT_ATTEMPTS + 1):
        try:
            cap = cv2.VideoCapture(state.rtsp_url or DEFAULT_RTSP_URL)
            # Don't set FPS - let camera use its natural rate
           
            if cap.isOpened():
                ret, _ = cap.read()
                if ret:
                    print(f"[INFO] Camera connected on attempt {attempt}")
                    
                    # Detect actual camera FPS
                    actual_fps = detect_camera_fps(cap)
                    processing_fps = actual_fps * CAMERA_FPS_RATIO
                    
                    print(f"[INFO] Initial camera FPS: {actual_fps:.1f}, Processing at: {processing_fps:.1f} ({CAMERA_FPS_RATIO*100:.0f}%)")
                    print(f"[INFO] FPS will be re-measured every 10 seconds to adapt to changes")
                    
                    # Store the processing FPS globally
                    global CAMERA_FPS
                    CAMERA_FPS = processing_fps
                    
                    return cap
            cap.release()
        except Exception as e:
            print(f"[ERROR] Camera connection failed: {e}")
       
        if attempt < CAMERA_RECONNECT_ATTEMPTS:
            time.sleep(CAMERA_RECONNECT_DELAY)
   
    raise RuntimeError("Failed to connect to camera")

